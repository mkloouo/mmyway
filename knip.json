{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "scripts/*.mjs",
    "plugins/*.js",
    "src/db/migrations.ts",
    "tolgee.config.js"
  ],
  "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "scripts/**/*.{mjs,ts}", "plugins/*.js"],
  "ignore": ["src/api/ff3/types.ts"],
  "ignoreDependencies": [
    "babel-jest",
    "babel-plugin-inline-import",
    "babel-preset-expo",
    "react-native-worklets",
    "expo-updates"
  ],
  "ignoreBinaries": ["eas"]
}
