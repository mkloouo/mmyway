{
  "name": "mmyway",
  "version": "1.3.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android:clean:dev": "APP_VARIANT=development npx expo prebuild -p android --clean",
    "android:clean:pro": "APP_VARIANT=production npx expo prebuild -p android --clean",
    "android:build:dev": "eas build -p android -e development --local",
    "android:build:pro": "eas build -p android -e production --local",
    "android:run:dev": "APP_VARIANT=development npx expo run:android --variant release",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check": "tsc --noEmit && expo lint && jest --ci",
    "db:generate": "drizzle-kit generate",
    "release": "node scripts/release.mjs",
    "i18n:push": "tolgee push",
    "i18n:pull": "tolgee pull",
    "android:build:aab": "eas build -p android -e production-aab --local"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.104.0",
    "drizzle-orm": "^0.45.3",
    "expo": "~57.0.25",
    "expo-background-task": "~57.0.20",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "^57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-share-intent": "^8.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.20",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@tolgee/cli": "^2.20.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.13",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "57.0.5",
    "prettier": "^3.9.9",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
